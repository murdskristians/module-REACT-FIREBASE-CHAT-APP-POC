# Demo mode: run with no backend at all. Firebase is replaced by the in-memory
# store in src/demo - every visitor is an auto-signed-in guest, data lives in
# the tab, and none of the variables below are needed.
# REACT_APP_DEMO_MODE=true

# Firebase Configuration (required unless REACT_APP_DEMO_MODE=true)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Groq API Configuration (ignored in demo mode, which answers locally)
REACT_APP_GROQ_API_KEY=your_groq_api_key_here
